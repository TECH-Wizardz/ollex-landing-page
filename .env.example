# Web3Forms access key for the "Get started" email form (https://web3forms.com).
# Public by design: it is inlined into the browser bundle, because the free plan
# only accepts browser submissions. Required for production builds.
WEB3FORM_ACCESS_KEY=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional: leave it empty and
# no analytics script is loaded. Read when the site is built, not at runtime.
GOOGLE_ANALYTICS_ID=
